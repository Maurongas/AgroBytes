# Copia este archivo como .env (no se sube a git). Todo tiene valores por defecto en docker-compose.yml,
# así que solo hace falta si quieres cambiar algo.

# --- Base de datos ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=agridb
DATABASE_URL=postgresql+psycopg://admin:password@db:5432/agridb

# --- Backend ---
CORS_ORIGINS=http://localhost:3000
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
CLIMATE_CACHE_DAYS=30
# Máximo de análisis (POST /api/v1/analyses) por IP por minuto; 0 = sin límite
RATE_LIMIT_ANALYSES_PER_MIN=30
# true = historial/detalle/borrado exigen el header X-Device-Id (actívalo cuando el frontend ya lo mande)
REQUIRE_DEVICE_ID=false

# --- Frontend ---
VITE_API_URL=http://localhost:8000
# true = datos de ejemplo; false = usa el backend real
VITE_USE_MOCK=true
