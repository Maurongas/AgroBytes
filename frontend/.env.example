# Solo si corres el frontend SIN Docker: copia este archivo como .env.local
# Con Docker, estas variables vienen de docker-compose.yml.
VITE_API_URL=http://localhost:8000
# false = usa el backend de VITE_API_URL; true = datos de ejemplo (src/api/mock.ts) si no tienes el backend prendido
VITE_USE_MOCK=false
